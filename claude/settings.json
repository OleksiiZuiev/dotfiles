{
  "permissions": {
    "allow": [
      "Bash:*",
      "Edit:*",
      "Write:*",
      "Read:*",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill(git-commit)",
      "Skill(ds:*)",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-update-page",
      "mcp__linear-server__*"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-bad-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[console]::beep(1000, 400)\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[console]::beep(600, 200); Start-Sleep -Milliseconds 100; [console]::beep(800, 200)\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /c/Users/OleksiiZuiev/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium"
}
